{
  "manifest_version": 3,
  "name": "音色采集器",
  "version": "1.0.0",
  "description": "采集当前标签页中的音频，导出为 WAV，并可保存到 CosyVoice 音色库。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "tabCapture",
    "offscreen",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "采集当前页面音色",
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}
