# ===========================================================================
# CosyVoice Web —— 后端配置
# 所有变量均以 CV_ 前缀，复制为 .env 后按需修改。
# ===========================================================================

# --- 服务 ---
CV_HOST=0.0.0.0
CV_PORT=8000
CV_LOG_LEVEL=INFO
# 允许跨域的前端地址（JSON 数组）
CV_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- CosyVoice 运行时 ---
# CosyVoice 官方仓库在本机的路径（由 scripts/setup_cosyvoice.sh 克隆）
CV_COSYVOICE_REPO=../CosyVoice
# 本地模型目录，或 ModelScope repo id（如 iic/CosyVoice2-0.5B）
CV_MODEL_DIR=../CosyVoice/pretrained_models/CosyVoice2-0.5B
# 加速开关（需要 CUDA；CPU 环境会自动降级）
CV_LOAD_JIT=false
CV_LOAD_TRT=false
CV_LOAD_VLLM=false
CV_FP16=false

# 启动时立即加载模型。
# true  —— 启动稍慢，但首次请求无需等待，且接口能返回模型内置音色列表（推荐）
# false —— 懒加载，首次合成时自动加载（真实模型可能需要数分钟）
CV_PRELOAD_MODEL=true

# --- 数据目录 ---
CV_DATA_DIR=../data
CV_MAX_UPLOAD_MB=30
CV_MAX_PROMPT_SECONDS=30
